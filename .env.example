# Bluesky login handle or email
BSKY_IDENTIFIER=your-handle.bsky.social

# Bluesky app password (not your account password)
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional custom PDS host
BSKY_PDS_HOST=https://bsky.social

# Optional post text (caption). The cowsay image is attached to the post.
BSKY_POST_TEXT=cowsay

# Fortune source: "llm" (default) or "command" for a custom shell pipeline.
COWSAY_SOURCE=llm

# OpenAI-compatible chat-completions API. Set host, port, and /v1 path.
# Local Ollama: http://127.0.0.1:11434/v1
# Remote Ollama: http://192.168.1.20:11434/v1
# llama.cpp server: http://192.168.1.20:8080/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Must match a model/alias exposed by the selected server.
LLM_MODEL=qwen2.5:3b
# Leave blank for local Ollama; set for providers that require authentication.
LLM_API_KEY=
# Avoid empty replies from thinking models (Ollama supports 'none').
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=256
LLM_TIMEOUT=90

# Used only when COWSAY_SOURCE=command. The default preserves the classic fortune pipeline.
COWSAY_GENERATOR=fortune | cowsay | lolcat -f

# Optional monospace font settings for image rendering
BSKY_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf
BSKY_FONT_SIZE=18
